# Local dev normally uses the single workspace .env one folder up (../.env).
# On Vercel set these in Project Settings -> Environment Variables.

# Supabase Postgres. Use the pooler URL (port 6543) for Vercel, WITHOUT ?sslmode, and set DATABASE_SSL=true.
DATABASE_URL=postgresql://lplatform:lplatform_dev@localhost:5432/lplatform
DATABASE_SSL=false
PG_POOL_MAX=20

PORT=3001
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# At least 32 random characters each (e.g. `openssl rand -hex 32`). Never reuse between environments.
JWT_SECRET=
COOKIE_SECRET=
JWT_ACCESS_TOKEN_EXPIRY=15m

# Comma-separated browser origins allowed to call the API (web portal + desktop app).
CORS_ORIGIN=http://localhost:3000,http://localhost:1420,tauri://localhost,http://tauri.localhost,https://tauri.localhost
ENABLE_DEMO_RESET=false

# Optional: Supabase Auth / Edge Functions
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: OCI object storage for attachments (uploads return 503 until configured)
OCI_REGION=
OCI_TENANCY_OCID=
OCI_USER_OCID=
OCI_FINGERPRINT=
OCI_PRIVATE_KEY_PATH=
OCI_OBJECT_STORAGE_NAMESPACE=
OCI_OBJECT_STORAGE_BUCKET=
OCI_CONTENT_DATABASE_URL=

# Public installer downloads (/api/downloads/latest/:platform) from the desktop GitHub Releases.
# Token is only needed while the app repo is private: fine-grained, read-only "Contents" on that repo.
GITHUB_RELEASES_REPO=LPlatform/L_Platform_Application
GITHUB_RELEASES_TOKEN=
